{
  "name": "@rundum-immo/real-estate-appraisal-mcp",
  "version": "0.1.0",
  "description": "MCP server for German real-estate depreciation and purchase-price allocation powered by AfAMax",
  "type": "module",
  "license": "MIT",
  "author": "Rundum Immo",
  "homepage": "https://github.com/Rundum-Immo/real-estate-appraisal-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rundum-Immo/real-estate-appraisal-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Rundum-Immo/real-estate-appraisal-mcp/issues"
  },
  "keywords": ["mcp", "real-estate", "depreciation", "afa", "kaufpreisaufteilung", "germany"],
  "mcpName": "immo.rundum/real-estate-appraisal",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "bin": {
    "real-estate-appraisal-mcp": "dist/transports/stdio.js"
  },
  "exports": {
    ".": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "contract:check": "tsx --env-file-if-exists=.env scripts/check-afamax-contract.ts",
    "dev:http": "tsx watch --env-file-if-exists=.env src/transports/http.ts",
    "dev:stdio": "tsx --env-file-if-exists=.env src/transports/stdio.ts",
    "prepublishOnly": "pnpm check",
    "start": "node --env-file-if-exists=.env dist/transports/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.14.0"
}
